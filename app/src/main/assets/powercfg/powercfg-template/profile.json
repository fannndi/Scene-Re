{
  "platform": "sm6150",
  "platform_name": "Snapdragon 732G (SM7150-AC)",
  "framework": 130,
  "schema": {
    "vendor": "msm",
    "cores": 8,
    "clusters": [0, 6]
  },
  "alias": {
  },
  "schemes": {
    "powersave": {
      "call": [
        ["@cpu_freq", "policy0", "min", "-300MHz"],
        ["@cpu_freq", "policy6", "min", "-900MHz"],
        ["@gpu_freq", "min", "180MHz"],
        ["@set_priority", "top-app", "normal"],
        ["@set_priority", "foreground", "low"],
        ["@set_priority", "background", "min"]
      ]
    },
    "balance": {
      "call": [
        ["@cpu_freq", "policy0", "min", "-100MHz"],
        ["@cpu_freq", "policy6", "min", "-400MHz"],
        ["@gpu_freq", "min", "355MHz"],
        ["@set_priority", "top-app", "normal"],
        ["@set_priority", "foreground", "normal"],
        ["@set_priority", "background", "low"]
      ]
    },
    "performance": {
      "call": [
        ["@cpu_freq", "policy0", "min", "max"],
        ["@cpu_freq", "policy6", "min", "-100MHz"],
        ["@gpu_freq", "min", "565MHz"],
        ["@set_priority", "top-app", "high"],
        ["@set_priority", "foreground", "normal"],
        ["@set_priority", "background", "low"]
      ]
    },
    "fast": {
      "call": [
        ["@cpu_freq", "policy0", "1.4Ghz", "max"],
        ["@cpu_freq", "policy6", "1.4Ghz", "max"],
        ["@gpu_freq", "min", "650MHz"],
        ["@set_priority", "top-app", "max"],
        ["@set_priority", "foreground", "high"],
        ["@set_priority", "background", "normal"]
      ]
    },
    "pedestal": {
      "call": [
        ["@cpu_freq", "policy0", "max", "max"],
        ["@cpu_freq", "policy6", "max", "max"],
        ["@gpu_freq", "min", "700MHz"],
        ["@set_priority", "top-app", "max"],
        ["@set_priority", "foreground", "high"],
        ["@set_priority", "background", "normal"]
      ]
    }
  }
}
