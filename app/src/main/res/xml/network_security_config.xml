<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 默认禁止明文流量 -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- 仅对已知的官方域名放行明文（兼容旧配置/下载地址） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">vtools.omarea.com</domain>
        <domain includeSubdomains="true">vtools.oss-cn-beijing.aliyuncs.com</domain>
        <domain includeSubdomains="true">atools.oss-cn-shenzhen.aliyuncs.com</domain>
    </domain-config>
</network-security-config>
