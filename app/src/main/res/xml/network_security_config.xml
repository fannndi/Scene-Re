<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Disallow cleartext traffic by default -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Allow cleartext only for known official domains (compatibility with legacy configs/download URLs) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">vtools.omarea.com</domain>
        <domain includeSubdomains="true">vtools.oss-cn-beijing.aliyuncs.com</domain>
        <domain includeSubdomains="true">atools.oss-cn-shenzhen.aliyuncs.com</domain>
    </domain-config>
</network-security-config>
