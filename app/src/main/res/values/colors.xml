<?xml version="1.0" encoding="utf-8"?>
<!--
  Neutral + pastel palette.

  Surfaces, backgrounds and body text stay neutral (near-black / near-white
  grays) so the app reads calm; color comes back as SOFT pastels for icons,
  mode identities, links and charts (never saturated, never pure hues).

  Names are kept for compatibility — only the VALUES change.
-->
<resources>
    <color name="color_list_divider">@android:color/transparent</color>

    <!-- Neutral surfaces -->
    <color name="window_background_light">#F2F2F2</color>
    <color name="window_background_dark">#000000</color>
    <color name="cardBgDark">#000000</color>
    <color name="cardBgDarkCard">#1A1A1A</color>
    <color name="cardBgDarkTransparent">#90000000</color>
    <color name="cardBgLight">#FFFFFF</color>

    <!-- Interaction accents: muted blue (readable on both themes) -->
    <color name="scene_accent_light">#7C3AED</color>
    <color name="scene_on_accent_light">#FFFFFF</color>
    <color name="scene_accent_dark">#A78BFA</color>
    <color name="scene_on_accent_dark">#111111</color>
    <color name="scene_text_secondary_light">#6B6B6B</color>
    <color name="scene_text_secondary_dark">#9A9A9A</color>
    <color name="scene_divider_light">#14000000</color>
    <color name="scene_divider_dark">#1FFFFFFF</color>

    <!-- Pastel palette for icons / labels / small accents -->
    <color name="pastel_blue">#60A5FA</color>
    <color name="pastel_teal">#2DD4BF</color>
    <color name="pastel_green">#34D399</color>
    <color name="pastel_lime">#A3E635</color>
