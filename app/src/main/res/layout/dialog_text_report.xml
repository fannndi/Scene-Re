<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/report_title"
        style="@style/dialogTitle"
        android:text="@string/kernel_features_title" />

    <TextView
        android:id="@+id/report_desc"
        style="@style/dialogDesc"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/report_body"
            style="@style/textSmall"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <Button
        android:id="@+id/report_refresh"
        style="@style/dialogCancelBtn"
        android:layout_marginTop="12dp"
        android:text="@string/kernel_features_refresh" />

    <Button
        android:id="@+id/report_action"
        style="@style/dialogCancelBtn"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/report_close"
        style="@style/dialogConfirmBtn"
        android:layout_marginTop="8dp"
        android:text="@string/dialog_close" />
</LinearLayout>
