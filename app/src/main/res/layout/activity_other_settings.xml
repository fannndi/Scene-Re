<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:fitsSystemWindows="true"
    android:keepScreenOn="false">

    <com.omarea.common.ui.OverScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?android:actionBarSize">

        <LinearLayout
            android:id="@+id/settings_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <EditText
                android:id="@+id/settings_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_h"
                android:layout_marginEnd="@dimen/screen_h"
                android:layout_marginTop="@dimen/space_s"
                android:hint="@string/settings_filter_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <LinearLayout style="@style/ListCardItem">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/textTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:tag="section"
                        android:text="@string/settings_theme" />

                    <Button
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/theme_wallpaper"
                        android:onClick="onThemeClick"
                        android:layout_margin="2dp"
                        android:tag="10" />

                    <Button
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_marginStart="8dp"
                        android:background="@color/black_overlay"
                        android:onClick="onThemeClick"
                        android:layout_margin="2dp"
                        android:tag="-2" />

                    <Button
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/white"
                        android:onClick="onThemeClick"
                        android:layout_margin="2dp"
                        android:tag="-3" />

                    <Button
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/theme_light"
                        android:onClick="onThemeClick"
                        android:layout_margin="2dp"
                        android:tag="-1" />
                </LinearLayout>

                <Switch
                    android:id="@+id/settings_black_notification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_black_notification" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_black_notification_desc" />
            </LinearLayout>

            <LinearLayout style="@style/ListCardItem">

                <TextView
                    style="@style/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="section"
                    android:text="@string/settings_section_behaviour" />

                <Switch
                    android:id="@+id/settings_debug_layer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_debug_layer" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_debug_layer_desc" />

                <Switch
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:id="@+id/settings_help_icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_help_icon" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_help_icon_desc" />

                <Switch
                    android:id="@+id/settings_auto_exit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_auto_exit" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_auto_exit_desc" />

                <Switch
                    android:id="@+id/settings_saver_overlay_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:text="@string/settings_saver_overlay" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_saver_overlay_desc" />

                <TextView
                    style="@style/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:tag="section"
                    android:text="@string/settings_section_game" />

                <Switch
                    android:id="@+id/settings_game_priority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_game_priority" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_game_priority_desc" />

                <Switch
                    android:id="@+id/settings_game_preload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_game_preload" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_game_preload_desc" />

                <TextView
                    android:id="@+id/settings_game_preload_mb"
                    style="@style/textDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/settings_game_preload_mb_title" />

                <TextView
                    style="@style/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:tag="section"
                    android:text="@string/settings_section_display" />

                <Switch
                    android:id="@+id/settings_display_restart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_display_restart" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_display_restart_desc" />

                <Switch
                    android:id="@+id/settings_reduce_logging"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_reduce_logging" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_reduce_logging_desc" />

                <Switch
                    android:id="@+id/settings_kernel_crash_guard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_kernel_crash_guard" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_kernel_crash_guard_desc" />

                <Switch
                    android:id="@+id/settings_sf_pacing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_sf_pacing" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sf_pacing_desc" />

                <Switch
                    android:id="@+id/settings_root_watch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_root_watch" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_root_watch_desc" />

                <Switch
                    android:id="@+id/settings_irq_affinity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_irq_affinity" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_irq_affinity_desc" />

                <TextView
                    style="@style/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:tag="section"
                    android:text="@string/settings_section_charging" />

                <Switch
                    android:id="@+id/settings_bypass_charge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:onClick="onThemeClick"
                    android:tag="10"
                    android:text="@string/settings_bypass_charge" />

                <TextView
                    android:id="@+id/settings_bypass_charge_desc"
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_bypass_charge_desc" />

                <TextView
                    android:id="@+id/settings_bypass_charge_mode"
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_bypass_charge_mode_auto" />

                <TextView
                    style="@style/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:tag="section"
                    android:text="@string/settings_boot_title" />

                <Switch
                    android:id="@+id/settings_boot_delay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/settings_boot_delay" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_boot_delay_desc" />

                <TextView
                    android:id="@+id/settings_wifi_mac"
                    style="@style/textDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/settings_wifi_mac" />

                <TextView
                    android:id="@+id/settings_wifi_mac_summary"
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_wifi_mac_desc" />

                <TextView
                    android:id="@+id/settings_wifi_mac_mode"
                    style="@style/textDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/settings_wifi_mac_mode" />

                <TextView
                    android:id="@+id/settings_wifi_mac_mode_summary"
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_wifi_mac_mode_off" />

                <TextView
                    style="@style/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:tag="section"
                    android:text="@string/settings_logcat_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:text="@string/settings_logcat_desc"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/settings_logcat"
                        style="@style/SceneButton"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="12dp"
                        android:layout_width="wrap_content"
                        android:text="@string/settings_logcat_title"
                        android:textSize="11sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/settings_log_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout style="@style/ListCardItem">

                <TextView
                    style="@style/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="section"
                    android:text="@string/settings_tools_title" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_jit_compile_desc" />

                <Button
                    android:id="@+id/settings_jit_compile"
                    style="@style/SceneButton"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:text="@string/settings_jit_compile" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:text="@string/settings_fstrim_desc" />

                <Button
                    android:id="@+id/settings_fstrim"
                    style="@style/SceneButton"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:text="@string/settings_fstrim" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:text="@string/settings_backup_desc" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/settings_backup"
                        style="@style/SceneButton"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:text="@string/settings_backup" />

                    <Button
                        android:id="@+id/settings_restore"
                        style="@style/SceneButton"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:text="@string/settings_restore" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/ListCardItem">

                <TextView
                    style="@style/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="section"
                    android:text="@string/settings_uninstall_cleanup" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_uninstall_cleanup_desc" />

                <Button
                    android:id="@+id/settings_cleanup_scene"
                    style="@style/SceneButton"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:text="@string/settings_uninstall_cleanup_button" />
            </LinearLayout>

            <LinearLayout style="@style/ListCardItem">

                <TextView
                    android:id="@+id/settings_about"
                    style="@style/textDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:text="@string/menu_about" />
            </LinearLayout>

            <!-- Danger zone: kept apart from the everyday switches, and it
                 asks for confirmation in code before anything runs. -->
            <LinearLayout style="@style/ListCardItem">

                <TextView
                    style="@style/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="section"
                    android:text="@string/settings_danger_title"
                    android:textColor="@color/pastel_red" />

                <Switch
                    android:id="@+id/settings_disable_selinux"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/settings_disable_selinux" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_disable_selinux_desc" />
            </LinearLayout>
        </LinearLayout>
    </com.omarea.common.ui.OverScrollView>

    <include
        layout="@layout/layout_app_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
