<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/layout_app_bar"
        layout="@layout/layout_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.omarea.common.ui.OverScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?actionBarSize">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <LinearLayout
                style="@style/ListCardItem"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/app_tuning_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/linux" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/app_tuning_name"
                        style="@style/textTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp" />

                    <TextView
                        android:id="@+id/app_tuning_package"
                        style="@style/textSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/ListCardItem">

                <Switch
                    android:id="@+id/app_tuning_scene_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:switchPadding="6dp"
                    android:text="@string/app_tuning_scene_mode" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tuning_scene_mode_desc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/app_tuning_perf"
                style="@style/ListCardItemClickable"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/textTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_tuning_perf" />

                <TextView
                    android:id="@+id/app_tuning_perf_value"
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/ListCardItem">

                <Switch
                    android:id="@+id/app_tuning_brightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:switchPadding="6dp"
                    android:text="@string/app_tuning_brightness" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tuning_brightness_desc" />
            </LinearLayout>

            <LinearLayout style="@style/ListCardItem">

                <Switch
                    android:id="@+id/app_tuning_gps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:switchPadding="6dp"
                    android:text="@string/app_tuning_gps" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tuning_gps_desc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/app_tuning_rotation"
                style="@style/ListCardItemClickable"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/textTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_tuning_rotation" />

                <TextView
                    android:id="@+id/app_tuning_rotation_value"
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/ListCardItem">

                <Switch
                    android:id="@+id/app_tuning_monitor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:switchPadding="6dp"
                    android:text="@string/app_tuning_monitor" />

                <TextView
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tuning_monitor_desc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/app_tuning_cgroup_fg"
                style="@style/ListCardItemClickable"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/textTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_tuning_cgroup_fg" />

                <TextView
                    android:id="@+id/app_tuning_cgroup_fg_value"
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/app_tuning_cgroup_bg"
                style="@style/ListCardItemClickable"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/textTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_tuning_cgroup_bg" />

                <TextView
                    android:id="@+id/app_tuning_cgroup_bg_value"
                    style="@style/textSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </com.omarea.common.ui.OverScrollView>
</RelativeLayout>
