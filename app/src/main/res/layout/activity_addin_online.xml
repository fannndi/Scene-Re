<?xml version="1.0" encoding="utf-8"?>
<!--
  The WebView is inset at runtime (ActivityAddinOnline.onCreate) rather than via
  android:fitsSystemWindows, which has no effect once the window is laid out
  edge-to-edge (mandatory for targetSdk 36).
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTintMode="screen"
    android:clipToPadding="true"
    android:fitsSystemWindows="false"
    android:keepScreenOn="false"
    tools:openDrawer="start">

    <WebView
        android:id="@+id/vtools_online"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</androidx.drawerlayout.widget.DrawerLayout>
