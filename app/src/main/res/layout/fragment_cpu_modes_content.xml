<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.omarea.common.ui.OverScrollView
        android:id="@+id/cpu_modes_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/cpu_modes_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_vertical_margin">

            <LinearLayout
                android:id="@+id/cpu_modes_card_service_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/nav_scene_service_not_active"
                style="@style/ListCardItem"
                android:background="@null"
                android:layout_marginHorizontal="16dp"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/nav_icon_warn"
                            app:tint="?android:colorAccent" />

                        <TextView
                            style="@style/textDefault"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="@string/accessibility_activate" />
                    </LinearLayout>

                    <TextView
                        style="@style/textSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/accessibility_activate_desc" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cpu_modes_card_dynamic"
                style="@style/ListCardItem"
                android:background="@null"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp">

                <LinearLayout
                    android:layout_marginBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="@dimen/activity_horizontal_margin"
                        android:background="@drawable/action_menu_icon_bg"
                        android:backgroundTint="@color/colorPrimary"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/auto"
                        app:tint="#ffffff" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <Switch
                            android:id="@+id/dynamic_control"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/schedule_scene" />

                        <TextView
                            style="@style/textSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/schedule_scene_desc" />
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/dynamic_control_opts"
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.omarea.ui.UMExpandLayout
                        android:id="@+id/dynamic_control_opts2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/in_card_item_inactive"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.omarea.ui.HelpIcon
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:text="@string/schedule_screen_on_desc" />

                                <TextView
                                    style="@style/textTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_weight="1"
                                    android:text="@string/schedule_screen_on" />

                                <Spinner
                                    android:id="@+id/first_mode"
                                    style="@style/SceneSpinner"
                                    android:layout_width="110dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical|right"
                                    android:entries="@array/default_powercfg_mode_options"
                                    android:paddingRight="0dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/activity_vertical_margin"
                                android:orientation="horizontal">

                                <com.omarea.ui.HelpIcon
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:text="@string/schedule_screen_off_desc" />

                                <TextView
                                    style="@style/textTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_weight="1"
                                    android:text="@string/schedule_screen_off" />

                                <Spinner
                                    android:id="@+id/sleep_mode"
                                    style="@style/SceneSpinner"
                                    android:layout_width="110dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical|right"
                                    android:entries="@array/sleep_powercfg_mode_options"
                                    android:paddingRight="0dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/activity_vertical_margin"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingEnd="8dp">

                                <com.omarea.ui.HelpIcon
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:text="@string/schedule_enhanced_desc" />

                                <Switch
                                    android:id="@+id/strict_mode"
                                    style="@style/textTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_weight="1"
                                    android:text="@string/schedule_enhanced" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/activity_vertical_margin"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingEnd="8dp">

                                <com.omarea.ui.HelpIcon
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:text="@string/schedule_delay_desc" />

                                <Switch
                                    android:id="@+id/delay_switch"
                                    style="@style/textTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_weight="1"
                                    android:text="@string/schedule_delay" />

                            </LinearLayout>
                        </LinearLayout>
                    </com.omarea.ui.UMExpandLayout>

                    <ImageView
                        android:layout_below="@id/dynamic_control_opts2"
                        android:id="@+id/dynamic_control_toggle"
                        android:src="@drawable/arrow_down"
                        android:padding="4dp"
                        android:layout_centerHorizontal="true"
                        android:layout_width="60dp"
                        android:background="@drawable/in_card_item"
                        android:layout_height="24dp" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/extreme_performance"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="@dimen/activity_horizontal_margin"
                        android:background="@drawable/action_menu_icon_bg"
                        android:backgroundTint="@color/pastel_red"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/icon_danger"
                        app:tint="#ffffff" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <Switch
                            android:id="@+id/extreme_performance_on"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="@string/schedule_excellent" />

                        <TextView
                            style="@style/textSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/schedule_excellent_desc" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cpu_modes_card_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/nav_app_profiles"
                    style="@style/ListCardItemSmall"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/krscript_item_transparent"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="@dimen/activity_horizontal_margin"
                        android:background="@drawable/action_menu_icon_bg"
                        android:backgroundTint="@color/colorPrimary"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_menu_profile"
                        app:tint="#ffffff" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/textTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Per-app profiles" />

                        <TextView
                            style="@style/textSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Scene modes and settings for individual apps"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center_vertical"
                        android:alpha="0.8"
                        android:background="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/arrow"
                        app:tint="#808080" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_cpu_control"
                    style="@style/ListCardItemSmall"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/krscript_item_transparent"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="@dimen/activity_horizontal_margin"
                        android:background="@drawable/action_menu_icon_bg"
                        android:backgroundTint="@color/colorPrimary"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_menu_cpu"
                        app:tint="#ffffff" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/textTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="CPU control" />

                        <TextView
                            style="@style/textSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_nav_cpu_control_desc"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center_vertical"
                        android:alpha="0.8"
                        android:background="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/arrow"
                        app:tint="#808080" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_miui_thermal"
                    style="@style/ListCardItemSmall"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/krscript_item_transparent"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="@dimen/activity_horizontal_margin"
                        android:background="@drawable/action_menu_icon_bg"
                        android:backgroundTint="@color/colorPrimary"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_menu_hot"
                        app:tint="#ffffff" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/textTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="MIUI thermal" />

                        <TextView
                            style="@style/textSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Thermal and FPS lock configuration"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center_vertical"
                        android:alpha="0.8"
                        android:background="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/arrow"
                        app:tint="#808080" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nav_freeze"
                    style="@style/ListCardItemSmall"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/krscript_item_transparent"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="@dimen/activity_horizontal_margin"
                        android:background="@drawable/action_menu_icon_bg"
                        android:backgroundTint="@color/colorPrimary"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/shortcut_freeze_logo"
                        app:tint="#ffffff" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/textTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Freeze apps" />

                        <TextView
                            style="@style/textSmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Freeze background apps to save battery"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center_vertical"
                        android:alpha="0.8"
                        android:background="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/arrow"
                        app:tint="#808080" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.omarea.common.ui.OverScrollView>
</RelativeLayout>
