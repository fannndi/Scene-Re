<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!--<gradient
        android:angle="90"
        android:endColor="#0888"
        android:startColor="#0888" />-->
    <solid android:color="?android:colorPrimary" />
    <!-- Stroke colour: must differ from the window background -->
    <stroke
        android:width="0dp"
        android:color="?android:colorAccent" />
    <!-- Round the button's four corners -->
    <!-- android:radius: corner radius -->
    <corners android:radius="16dp" />

    <!-- padding: space between the button label and its edges -->
    <padding
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp" />
</shape>